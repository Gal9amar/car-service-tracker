{
  "name": "car-service-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "db:migrate": "cd server && npx prisma migrate deploy",
    "db:push": "cd server && npx prisma db push",
    "db:studio": "cd server && npx prisma studio",
    "postinstall": "cd server && npm install && cd ../client && npm install && cd .. && npx prisma generate --schema=server/prisma/schema.prisma"
  },
  "dependencies": {
    "@libsql/client": "^0.8.0",
    "@netlify/functions": "^2.8.0",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "pg": "^8.20.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0"
  }
}
