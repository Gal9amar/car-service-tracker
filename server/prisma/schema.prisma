generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  name          String
  googleId      String?   @unique @map("google_id")
  avatarUrl     String?   @map("avatar_url")
  isVerified    Boolean   @default(false) @map("is_verified")
  verifyCode    String?   @map("verify_code")
  verifyExpires DateTime? @map("verify_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  vehicles      Vehicle[]
  garageReviews GarageReview[]
  garagesAdded  Garage[]       @relation("GarageCreator")

  @@map("users")
}

model Vehicle {
  id           String @id @default(uuid())
  userId       String @map("user_id")

  // ── User input ────────────────────────────────────────────
  nickname       String?
  currentMileage Int?     @map("current_mileage")
  imageUrl       String?  @map("image_url")

  // ── Main (053cea08) ───────────────────────────────────────
  licensePlate     String   @map("license_plate")
  manufacturer     String
  manufacturerCode Int?     @map("manufacturer_code")
  model            String
  modelCode        String?  @map("model_code")
  modelId          Int?     @map("model_id")
  vehicleType      String?  @map("vehicle_type")
  year             Int
  color            String?
  colorCode        Int?     @map("color_code")
  fuelType         String?  @map("fuel_type")
  engineModel      String?  @map("engine_model")
  trim             String?
  safetyRating     String?  @map("safety_rating")
  pollutionLevel   Int?     @map("pollution_level")
  vin              String?
  frontTire        String?  @map("front_tire")
  rearTire         String?  @map("rear_tire")
  lastTest         DateTime? @map("last_test") @db.Date
  testExpiry       DateTime? @map("test_expiry") @db.Date
  ownership        String?
  registrationNote String?  @map("registration_note")
  firstRegistered  String?  @map("first_registered")

  // ── Technical (56063a99) ──────────────────────────────────
  engineNumber      String?  @map("engine_number")
  testKm            Int?     @map("test_km")
  structureChange   Boolean  @default(false) @map("structure_change")
  hasGrapam         Boolean  @default(false) @map("has_grapam")
  colorChange       Boolean  @default(false) @map("color_change")
  tireChange        Boolean  @default(false) @map("tire_change")
  firstRegisteredDate String? @map("first_registered_date")
  origin            String?

  // ── WLTP (142afde2) ───────────────────────────────────────
  horsePower           Int?     @map("horse_power")
  engineCC             Int?     @map("engine_cc")
  weight               Int?
  doors                Int?
  seats                Int?
  bodyType             String?  @map("body_type")
  driveType            String?  @map("drive_type")
  transmission         String?
  standardType         String?  @map("standard_type")
  towingWithBrakes     Int?     @map("towing_with_brakes")
  towingWithoutBrakes  Int?     @map("towing_without_brakes")
  airbags              Int?
  electricWindows      Int?     @map("electric_windows")
  hasAC                Boolean  @default(false) @map("has_ac")
  hasABS               Boolean  @default(false) @map("has_abs")
  hasPowerSteering     Boolean  @default(false) @map("has_power_steering")
  hasStabControl       Boolean  @default(false) @map("has_stab_control")
  hasSunroof           Boolean  @default(false) @map("has_sunroof")
  hasAlloyWheels       Boolean  @default(false) @map("has_alloy_wheels")
  hasTrunkRack         Boolean  @default(false) @map("has_trunk_rack")
  // Emissions
  co2                  Float?
  co2City              Float?   @map("co2_city")
  co2Highway           Float?   @map("co2_highway")
  nox                  Float?
  co                   Float?
  greenScore           Int?     @map("green_score")
  // Safety tech
  hasLaneDeparture     Boolean  @default(false) @map("has_lane_departure")
  hasForwardWarning    Boolean  @default(false) @map("has_forward_warning")
  hasBlindSpot         Boolean  @default(false) @map("has_blind_spot")
  hasAdaptiveCruise    Boolean  @default(false) @map("has_adaptive_cruise")
  hasPedestrianDetect  Boolean  @default(false) @map("has_pedestrian_detect")
  hasAutoEmergencyBrake Boolean @default(false) @map("has_auto_emergency_brake")
  hasRearCamera        Boolean  @default(false) @map("has_rear_camera")
  hasTirePressure      Boolean  @default(false) @map("has_tire_pressure")
  hasFatigueAlert      Boolean  @default(false) @map("has_fatigue_alert")
  safetyScore          Float?   @map("safety_score")
  hasAutoHighBeam      Boolean  @default(false) @map("has_auto_high_beam")
  hasSpeedLimiter      Boolean  @default(false) @map("has_speed_limiter")
  hasAlcoLock          Boolean  @default(false) @map("has_alco_lock")

  // ── JSON arrays ───────────────────────────────────────────
  ownershipHistory String? @map("ownership_history") // JSON
  recalls          String? // JSON

  govDataUpdatedAt DateTime? @map("gov_data_updated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services  Service[]
  expenses  Expense[]
  reminders Reminder[]

  @@unique([userId, licensePlate])
  @@map("vehicles")
}

enum ServiceType {
  PERIODIC
  OIL
  BRAKES
  TIRES
  BATTERY
  TEST
  AC
  TIMING_BELT
  FILTERS
  SUSPENSION
  ELECTRICAL
  BODY_WORK
  GENERAL
  OTHER
}

model Service {
  id                 String      @id @default(uuid())
  vehicleId          String      @map("vehicle_id")
  serviceType        ServiceType @map("service_type")
  description        String?
  date               DateTime    @db.Date
  mileage            Int?
  cost               Decimal     @db.Decimal(10, 2)
  garageId           String?     @map("garage_id")
  warrantyUntil      DateTime?   @map("warranty_until") @db.Date
  nextServiceMileage Int?        @map("next_service_mileage")
  createdAt          DateTime    @default(now()) @map("created_at")

  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  garage      Garage?             @relation(fields: [garageId], references: [id])
  attachments ServiceAttachment[]

  @@map("services")
}

model ServiceAttachment {
  id        String   @id @default(uuid())
  serviceId String   @map("service_id")
  fileUrl   String   @map("file_url")
  fileName  String   @map("file_name")
  fileType  String   @map("file_type")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_attachments")
}

enum ExpenseCategory {
  FUEL
  PARKING
  FINE
  INSURANCE
  LICENSE
  TOLL
  WASH
  ACCESSORIES
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  vehicleId   String          @map("vehicle_id")
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @db.Date
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

enum ReminderType {
  TEST
  OIL
  INSURANCE
  LICENSE
  TIRES
  BRAKES
  CUSTOM
}

model Reminder {
  id             String       @id @default(uuid())
  vehicleId      String       @map("vehicle_id")
  reminderType   ReminderType @map("reminder_type")
  title          String
  dueDate        DateTime?    @map("due_date") @db.Date
  dueMileage     Int?         @map("due_mileage")
  intervalMonths Int?         @map("interval_months")
  intervalKm     Int?         @map("interval_km")
  isActive       Boolean      @default(true) @map("is_active")
  lastNotified   DateTime?    @map("last_notified")
  createdAt      DateTime     @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Garage {
  id          String   @id @default(uuid())
  name        String
  address     String?
  city        String?
  phone       String?
  lat         Float?
  lng         Float?
  specialties String[] @default([])
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  creator  User?          @relation("GarageCreator", fields: [createdBy], references: [id])
  services Service[]
  reviews  GarageReview[]

  @@map("garages")
}

model GarageReview {
  id        String   @id @default(uuid())
  garageId  String   @map("garage_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  garage Garage @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([garageId, userId])
  @@map("garage_reviews")
}
